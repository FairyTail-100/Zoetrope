{
  "name": "zoetrope-monorepo",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" run build && node -e \"import('vite').then(async ({ build }) => { await build({ build: { lib: { entry: 'packages/core/src/index.ts', formats: ['es'], fileName: () => 'engine.bundle.js' }, outDir: 'benchmarks', emptyOutDir: false, minify: false } }); })\"",
    "build:examples": "tsx scripts/ensure-showcase-assets.ts && pnpm -r --filter=\"./examples/*\" run build",
    "typecheck": "tsc --build",
    "lint": "eslint packages tests",
    "test": "pnpm --filter @zoetrope/manifest build && vitest run",
    "test:watch": "vitest",
    "test:skills": "vitest run tests/skills-validator.test.ts",
    "test:scaffold": "tsx scripts/test-scaffold.ts",
    "test:packages": "tsx scripts/test-packages-install.ts",
    "test:core-install": "tsx scripts/test-packages-install.ts",
    "test:e2e": "tsx scripts/ensure-examples-built.ts && playwright test",
    "pack:all": "pnpm -r --filter=\"./packages/*\" pack --pack-destination dist-release",
    "release:build": "tsx scripts/build-release.ts",
    "skills:zip": "tsx scripts/zip-skills.ts",
    "version:check": "tsx scripts/check-version.ts",
    "clean": "tsx scripts/clean.ts",
    "clean:deep": "tsx scripts/clean.ts --deep",
    "bench": "tsx benchmarks/run-benchmarks.ts",
    "bench:check": "tsx benchmarks/check-regression.ts",
    "zoetrope": "tsx packages/compiler/src/cli.ts",
    "demo:video": "tsx scripts/demo-video.ts",
    "skills:install": "tsx scripts/install-skills.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/selfsigned": "^2.1.0",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "ffmpeg-static": "^5.3.0",
    "happy-dom": "^21.0.4",
    "rollup": "^4.68.3",
    "rollup-plugin-dts": "^6.5.1",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "author": "FairyTail-100",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FairyTail-100/Zoetrope.git"
  },
  "homepage": "https://github.com/FairyTail-100/Zoetrope#readme",
  "bugs": {
    "url": "https://github.com/FairyTail-100/Zoetrope/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
