---
// Astro Component Server Frontmatter
const title = "Zoetrope Astro Island Example";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
      body { margin: 0; background: #0b0c10; color: #fff; }
      .scroll-container { height: 300vh; position: relative; }
      .sticky-wrap { position: sticky; top: 0; width: 100vw; height: 100vh; }
      canvas { width: 100%; height: 100%; display: block; }
    </style>
  </head>
  <body>
    <main class="scroll-container">
      <div class="sticky-wrap">
        <canvas id="astro-canvas"></canvas>
      </div>
    </main>

    <!-- Client-side hydration script (Astro client:load island equivalent) -->
    <script>
      import { mountZoetropeIsland } from '../client.js';
      mountZoetropeIsland('astro-canvas', '/assets/showcase/manifest.json');
    </script>
  </body>
</html>
